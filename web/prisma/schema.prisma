generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Cefr {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum CorrectionMode {
  SUBTLE
  EXPLICIT
  OFF
}

enum Pace {
  SLOW
  NATURAL
}

enum SessionType {
  SHADOWING
  LESSON
  ROLEPLAY
  FREE_TALK
  MISTAKE_REVIEW
}

enum SessionStatus {
  CREATED
  ACTIVE
  ENDED
  RECAP_READY
  FAILED
}

enum Dialect {
  MX
  ES
  NEUTRAL
}

enum UnitStatus {
  NOT_STARTED
  IN_PROGRESS
  MASTERED
}

enum TargetKind {
  WORD
  PATTERN
}

enum MistakeCategory {
  GRAMMAR
  VOCABULARY
  WORD_ORDER
  AGREEMENT
  CONJUGATION
  PRONUNCIATION
  OTHER
}

model Language {
  code       String  @id
  name       String
  nativeName String
  voice      String
  enabled    Boolean
}

model Learner {
  id                String         @id @default("owner")
  targetLanguage    String
  nativeLanguage    String         @default("en")
  level             Cefr
  dialect           Dialect        @default(MX)
  goals             String?
  correctionMode    CorrectionMode @default(SUBTLE)
  pace              Pace           @default(SLOW)
  voice             String
  sessionCapMinutes Int            @default(20)
  onboardedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  vocabItems        VocabItem[]
  mistakes          Mistake[]
  unitProgress      UnitProgress[]
}

model Unit {
  id             String         @id
  language       String
  dialect        Dialect
  level          Cefr
  order          Int
  title          String
  canDo          String
  pattern        Json
  targetWords    Json
  modelSentences Json
  scenarioHint   String?
  sessions       Session[]
  progress       UnitProgress[]

  @@unique([language, dialect, level, order])
}

model UnitProgress {
  id            String     @id @default(cuid())
  learnerId     String
  unitId        String
  status        UnitStatus @default(NOT_STARTED)
  wordScores    Json
  patternScore  Int        @default(0)
  sessionsCount Int        @default(0)
  masteredAt    DateTime?
  updatedAt     DateTime   @updatedAt
  learner       Learner    @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  unit          Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([learnerId, unitId])
}

model Scenario {
  id          String    @id
  language    String
  title       String
  description String
  minLevel    Cefr
  setting     String
  tutorRole   String
  learnerRole String
  goals       String[]
  sessions    Session[]
}

model Session {
  id                 String         @id @default(cuid())
  type               SessionType
  status             SessionStatus
  scenarioId         String?
  unitId             String?
  topic              String?
  roomName           String         @unique
  brief              Json
  transcript         Json?
  recap              Json?
  startedAt          DateTime?
  endedAt            DateTime?
  durationSec        Int?
  estimatedCostCents Int?
  createdAt          DateTime       @default(now())
  scenario           Scenario?      @relation(fields: [scenarioId], references: [id])
  unit               Unit?          @relation(fields: [unitId], references: [id])
  mistakes           Mistake[]
  memory             SessionMemory?
}

model VocabItem {
  id              String    @id @default(cuid())
  learnerId       String
  word            String
  translation     String
  example         String?
  note            String?
  ease            Float     @default(2.5)
  intervalDays    Int       @default(0)
  reps            Int       @default(0)
  dueAt           DateTime
  lastReviewedAt  DateTime?
  sourceSessionId String?
  unitId          String?
  learner         Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@unique([learnerId, word])
}

model Mistake {
  id             String          @id @default(cuid())
  learnerId      String
  sessionId      String
  original       String
  corrected      String
  explanation    String
  category       MistakeCategory
  timesPracticed Int             @default(0)
  resolved       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  learner        Learner         @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  session        Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model SessionMemory {
  id        String   @id @default(cuid())
  sessionId String   @unique
  summary   String
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
