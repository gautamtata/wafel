# Prisma Postgres (injected by the Vercel Prisma integration; `vercel env pull .env.local`)
DATABASE_URL=

# Single-user auth
APP_PASSPHRASE=
APP_SECRET=
# IANA zone for streaks and day labels (default America/Los_Angeles)
APP_TIME_ZONE=

# Shared secret between the web app and the LiveKit agent
AGENT_SHARED_SECRET=

# OpenAI
OPENAI_API_KEY=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Tests: `bun run test` writes to a database. Point it at a dedicated one here, or set
# WAFEL_ALLOW_SHARED_DB_TESTS=1 to let it use DATABASE_URL (rows are prefixed `test-`).
DATABASE_URL_TEST=
